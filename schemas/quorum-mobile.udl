// Quorum mobile UniFFI contract (workflow: quorum.field_signal_capture.v1).
//
// Source of truth: schemas/quorum-mobile.udl (this file, the canonical
// contract doc). Compiled copy: apps/marquee/quorum-sense/ffi/src/quorum_mobile.udl,
// read by apps/marquee/quorum-sense/ffi/build.rs. scripts/check-mobile-scaffold.sh
// requires the two files to stay byte-identical.
//
// The namespace matches the [lib] name of apps/marquee/quorum-sense/ffi
// (quorum_ffi) so the generated Swift/Kotlin bindings resolve
// the native library under the same name, mirroring crates/shell-ffi.

// Typed boundary error. The only failures that can cross this seam are a numeric
// range (confidence) and the AI-routing inputs that are still strings. Modality,
// consent, event-type and sync-state are *enums* on the wire (below), so an
// invalid one is a compile error on the caller, not a runtime error here — hence
// no InvalidModality / InvalidConsentState: those states are unrepresentable.
[Error]
interface QuorumError {
    ConfidenceOutOfRange(f32 value);
    UnsupportedPlatform(string value);
    UnsupportedTask(string value);
};

// Wire enums: the contract carries domain enums, not strings, so neither Swift
// nor Kotlin can build a draft with an unknown modality/consent (and the core
// can't emit an unknown event/sync). Misuse is caught by the type system.
enum SignalModality {
    "Text",
    "VoiceTranscript",
    "ImageOcrText",
};

enum ConsentState {
    "Pending",
    "Consented",
};

enum AppendEventType {
    "SignalDraftConsented",
};

enum SyncState {
    "QueuedForSync",
};

dictionary FfiAppSummary {
    string slug;
    string display_name;
    string family;
    string status;
    string source_repo;
};

dictionary FfiQuorumSignalDraft {
    string workflow_id;
    string draft_id;
    string inquiry_thread_id;
    SignalModality modality;
    string raw_capture;
    string summary;
    string latent_need;
    string contradiction;
    float confidence;
    ConsentState consent_state;
};

dictionary FfiQuorumAppendEvent {
    string workflow_id;
    AppendEventType event_type;
    string draft_id;
    string inquiry_thread_id;
    SyncState sync_state;
};

enum GateVerdict {
    "Approve",
    "Reject",
};

enum ReviewStance {
    "Agree",
    "Disagree",
    "NeedMoreContext",
};

enum ContextLevel {
    "Task",
    "LocalContext",
    "Session",
    "Formation",
    "Organization",
    "Everything",
};

enum BlockingState {
    "NotBlocking",
    "BlocksFormation",
    "BlocksSession",
};

enum WaitingForKind {
    "Nobody",
    "Participants",
    "Server",
};

enum DirectorPromptKind {
    "Judgment",
    "Gate",
    "Review",
};

enum DirectorIntentKind {
    "OpenTask",
    "SubmitJudgment",
    "RespondGate",
    "SubmitReview",
    "RequestContext",
};

dictionary FfiWaitingFor {
    WaitingForKind kind;
    sequence<string>? actor_labels;
};

dictionary FfiNowTask {
    string objective;
    string? needed_from_user;
    u32? estimated_minutes;
};

dictionary FfiChoice {
    string choice_id;
    string label;
};

dictionary FfiJudgmentPrompt {
    string question;
    string body;
    sequence<FfiChoice> choices;
};

dictionary FfiGatePrompt {
    string gate_id;
    string reason;
    string consequence;
    u64? deadline_ms;
    string condition_kind;
};

dictionary FfiReviewPrompt {
    string title;
    string primary_evidence;
};

dictionary FfiDirectorIntent {
    DirectorIntentKind kind;
    string? frame_id;
    string? choice_id;
    string? gate_id;
    GateVerdict? gate_verdict;
    ReviewStance? review_stance;
    ContextLevel? context_level;
};

dictionary FfiDirectorPrompt {
    DirectorPromptKind kind;
    FfiJudgmentPrompt? judgment;
    FfiGatePrompt? gate;
    FfiReviewPrompt? review;
};

dictionary FfiPrimaryAction {
    string label;
    FfiDirectorIntent intent;
};

dictionary FfiSecondaryAction {
    string label;
    FfiDirectorIntent intent;
};

dictionary FfiPresenceHint {
    string actor_label;
    string status;
};

dictionary FfiDirectorFrame {
    string frame_id;
    string title;
    string? subtitle;
    FfiNowTask? now;
    FfiWaitingFor waiting_for;
    FfiPrimaryAction primary;
    sequence<FfiSecondaryAction> secondary;
    FfiDirectorPrompt? prompt;
    sequence<FfiPresenceHint> presence;
    sequence<ContextLevel> context_trail;
    BlockingState blocking;
};

dictionary FfiDirectorSnapshot {
    u64 version;
    FfiDirectorFrame frame;
};

namespace quorum_ffi {
    // Initialise Rust-side crash/error reporting (Sentry). Idempotent — only the
    // first call wires the client. DSN/environment/release come from the host app
    // so Rust events land in the separate Rust Sentry project, not the app ones.
    void init_observability(
        string dsn,
        string environment,
        string release,
        boolean debug
    );

    sequence<FfiAppSummary> mobile_portfolio();

    [Throws=QuorumError]
    string ai_execution_home(string platform, string task);

    string quorum_field_signal_workflow_id();

    // No [Throws]: `modality` is an enum, so this can no longer fail on it, and
    // the other inputs are free-form text.
    FfiQuorumSignalDraft quorum_draft_field_signal(
        string inquiry_thread_id,
        SignalModality modality,
        string raw_capture
    );

    // Still throws: `confidence` is a float and must be range-checked here.
    [Throws=QuorumError]
    FfiQuorumAppendEvent quorum_append_consented_signal(
        FfiQuorumSignalDraft draft
    );

    // AI Director projection boundary (director-contracts via mobile-core).
    FfiDirectorSnapshot quorum_current_director_snapshot();

    // Configure live Quorum director snapshot fetch (GET /api/director/snapshot).
    // Call once at startup in debug/local builds; omit to stay on fixtures only.
    void quorum_configure_director_api(string base_url, string bearer_token);

    // Wire label for the last `quorum_current_director_snapshot` resolution:
    // `live`, `fixture`, or `fixture_fallback:<reason>`.
    string quorum_director_snapshot_source();

    void quorum_submit_director_intent(FfiDirectorIntent intent);
};
