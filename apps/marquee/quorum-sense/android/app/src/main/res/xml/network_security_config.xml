<?xml version="1.0" encoding="utf-8"?>
<!-- The on-device refinement loop's cloud-fallback tier (M6) talks to a local
     Quorum refine-service over the emulator host loopback (10.0.2.2) and device
     loopback. Cleartext is scoped to these dev-only hosts so the rest of the app
     keeps Android's cleartext-blocked default. A device/production build points
     the native LlmBackend at an HTTPS GC-Secrets backend instead. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
